<?xml version="1.0" encoding="utf-8"?>
<!-- Student data must never be copied off the phone automatically (RA 10173).
     The encrypted database is also useless without its Keystore key, which
     cannot be transferred. Instructors use ACEkor's own encrypted backup file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
