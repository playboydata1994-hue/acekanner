{
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-import-prefix",
        "require-await"
      ]
    }
  },
  "tasks": {
    "test": "deno test --allow-read=.,../app/test/fixtures,../acekor/app/test/fixtures tests/deno",
